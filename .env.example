# Local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pocketpatient
REDIS_URL=redis://localhost:6379/0
# development | test | production. Production (also forced automatically on Cloud
# Run) fails startup if any required secret below is missing or malformed.
APP_ENV=development

# GCP (Cloud Run / production)
# Cloud SQL (via Cloud SQL Auth Proxy or connector)
# DATABASE_URL=postgresql+asyncpg://<db-user>@/<db-name>?host=/cloudsql/<project>:<region>:<instance>
# DB_PASSWORD=<from Secret Manager>   # applied to DATABASE_URL; keep it out of the URL
# Cloud Run's front end appends the client IP to X-Forwarded-For; required for
# per-client rate limiting (otherwise all clients share one bucket). Required
# (>= 1) in production. Use 2 only behind an external HTTPS load balancer AND with
# --ingress=internal-and-cloud-load-balancing, else XFF can be spoofed.
# TRUSTED_PROXY_COUNT=1
# Memorystore Redis
# REDIS_URL=redis://<memorystore-ip>:6379/0

# GCP project
# GCP_PROJECT_ID=pocket-patient-v2
# GCP_REGION=us-east1
# ARTIFACT_REGISTRY=us-east1-docker.pkg.dev/pocket-patient-v2/backend

# Cloud Storage bucket for disease-document uploads (required in production;
# unset = local /tmp storage for dev). Runtime service account needs
# roles/storage.objectAdmin on this bucket.
# GCS_UPLOAD_BUCKET=pocket-patient-uploads

# App Store review / demo: accept verified emails from ANY domain (not just
# Rutgers). Opens sign-up to everyone — enable for the review window only.
# ALLOW_NON_RUTGERS_ACCOUNTS=false

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json  # path to a service account JSON *file* (Cloud Run: secret volume mount path)

# JWT (RS256) — generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#   Real multi-line PEMs (e.g. Secret Manager env vars) work as-is.
#   For .env, convert to single-line: awk 'NF {printf "%s\\n",$0;}' jwt_private.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Gemini (LLM patient generation) — get a free-tier key at https://aistudio.google.com/apikey
# Required to run the app against real Gemini; the test suite mocks it and does not need a key.
GEMINI_API_KEY=your-gemini-api-key
